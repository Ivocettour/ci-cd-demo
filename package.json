{
  "name": "ci-cd-demo",
  "version": "1.0.0",
  "description": "API Express de demostracion para una evaluacion de CI/CD",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "validate:openapi": "node scripts/validate-openapi.js",
    "test": "node --test __tests__/app.test.js",
    "build": "npm run lint && npm run validate:openapi && npm test"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "supertest": "^7.2.2"
  }
}
